# ── Python environments ──
.venv/
**/.venv/
venv/
env/

# ── Python build / cache ──
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/

# ── Local archive ──
/Ignore/

# ── XRD-app projects & workspaces (GUI-created at runtime; never commit) ──
# Ignore runtime data trees wherever they appear. Tracked xrd_app CVEvolve
# source/assets are intentionally not matched by these runtime-output patterns.
**/mlruns/
**/sessions/
**/Raw/
**/Binned/
**/Metadata/
**/Labels/
**/Figures/
**/CVEvolve/
**/Study/
**/Study_*/
**/cvevolve_*/
**/cvevolve-*/
**/*cvevolve*/runs/
**/*cvevolve*/sessions/
**/*cvevolve*/mlruns/

# ── Generated analysis outputs ──
**/results/
**/holdout_data/
**/test_data/

# ── Large binary data formats ──
*.h5
*.hdf5
*.tif
*.tiff
*.npy
*.npz

# Exception: shared physics-input assets bundled with the package
!xrd_app/assets/
!xrd_app/assets/tth.tiff

# ── Generated Jupyter documents; tracked tutorials use notebooks/*.py ──
*.ipynb

# ── Images / preview renders ──
*.png
*.jpg
*.jpeg

# ── Large reference PDFs ──
*.pdf

# ── Secrets ──
.env
*.key

# ── Claude Code local settings (machine-specific) ──
**/.claude/settings.local.json

# ── OS / editor cruft ──
.DS_Store
Thumbs.db
.vscode/
.idea/
